rules_version = '2';

// ─────────────────────────────────────────────────────────────────────
//  Vista360 Player — reglas de seguridad de Firestore
//
//  Basadas en las que estaban publicadas el 5 de agosto de 2026 (copia
//  íntegra en docs/reglas/produccion-2026-08-05.rules.txt, que sirve de
//  vuelta atrás), simplificadas tras confirmar que el ERP Vista360 y
//  facturacion-web ya no se usan.
//
//  EL CAMBIO DE FONDO: se elimina isHuman().
//
//  Esa función decía "tiene sesión y NO tiene ficha en portalUsers", y
//  concedía acceso de administrador a gastos, sueldos, proveedores,
//  edición de clientes y borrado de contratos. O sea: CUALQUIER cuenta
//  de Firebase sin ficha de portal era tratada como dueño del ERP. Se
//  sostenía en que nadie más pudiera crear una cuenta -- si el registro
//  por correo estuviera abierto en Authentication, cualquiera podía
//  entrar y quedarse con todo. Ahora que el ERP no se usa, esa puerta no
//  le sirve a nadie y solo era superficie de ataque: se cierra.
//
//  PRINCIPIO: el navegador LEE lo suyo y NO ESCRIBE nada, salvo una
//  única excepción acotada. Todo lo demás pasa por Cloud Functions, que
//  usan el Admin SDK y no pasan por estas reglas -- por eso pueden ser
//  tan estrictas sin romper la aplicación.
//
//  Verificado contra el código: el navegador hace exactamente UNA
//  escritura directa (marcar una solicitud como revisada). Las
//  concesiones que había para calificar campañas y subir comprobantes
//  de pago se retiran: esas funciones no existen en la aplicación.
// ─────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Quién es quién ──────────────────────────────────────────────

    /** Tiene sesión Y ficha en portalUsers (cliente o personal). */
    function esCuentaDePortal() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/portalUsers/$(request.auth.uid));
    }

    /** A qué cliente pertenece quien pide. */
    function clienteIdDelPortal() {
      return get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.clienteId;
    }

    /** Personal de Vista360 ("admin" es el nombre histórico del Gerente). */
    function esAdminPortal() {
      return esCuentaDePortal() &&
        get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.role == 'admin';
    }

    /** Personal interno: Gerente O Trabajador.
     *
     *  OJO CON LA DIFERENCIA. esAdminPortal() exige role == 'admin', o
     *  sea SOLO el Gerente. Un Trabajador tiene role == 'trabajador' y
     *  NO la cumple. Eso es un problema que viene de antes y que no se
     *  toca acá (cambiar esAdminPortal() afectaría a media docena de
     *  colecciones a la vez); esta función se usa únicamente para el
     *  agregado del selector, que es la pantalla de inicio de CUALQUIER
     *  cuenta interna y por tanto también de un Trabajador.
     */
    function esPersonalDePortal() {
      return esCuentaDePortal() &&
        get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.role in ['admin', 'trabajador'];
    }

    /** ¿Este documento es del cliente que lo pide? */
    function esDeMiCliente() {
      return esCuentaDePortal() && resource.data.cliente_id == clienteIdDelPortal();
    }

    // ── portalUsers: acá vive el campo `role` ───────────────────────
    // Escritura CERRADA del todo. Antes el navegador podía actualizar
    // los campos de analítica (lastLogin, pantallasVisitadas); ya no
    // hace falta: desde el 5 de agosto eso pasa por las Cloud Functions
    // registrarAcceso/registrarVisita. Cerrarlo elimina cualquier duda
    // sobre si `role` podría tocarse por algún resquicio.
    match /portalUsers/{uid} {
      allow read: if esAdminPortal() || (request.auth != null && request.auth.uid == uid);
      allow write: if false;
    }

    // ── Datos del cliente ───────────────────────────────────────────

    match /clientes/{id} {
      allow read: if esAdminPortal() || (esCuentaDePortal() && id == clienteIdDelPortal());
      allow write: if false; // crearClienteNuevo / actualizarClienteInfo
    }

    match /contratos/{id} {
      allow read: if esAdminPortal() || esDeMiCliente();
      allow write: if false; // crearContrato / actualizarContrato / eliminarContrato
    }

    match /informesCliente/{id} {
      allow read: if esAdminPortal() || esDeMiCliente();
      allow write: if false; // generarReporteCliente / marcarReporteVisto
    }

    // Las facturas se identifican por RUC (cliente_doc), que es como las
    // generaba el sistema de facturación. La escritura queda cerrada:
    // ya no se emiten desde ahí, y crearFacturaAdmin/eliminarFactura son
    // Cloud Functions.
    match /facturas/{id} {
      allow read: if esAdminPortal() ||
        (esCuentaDePortal() &&
          resource.data.cliente_doc ==
            get(/databases/$(database)/documents/clientes/$(clienteIdDelPortal())).data.ruc);
      allow write: if false;
    }

    // ── Inventario ──────────────────────────────────────────────────
    // Lectura para cualquier cuenta de portal, a propósito: Cobertura le
    // muestra a cada cliente TODO el inventario para que pueda pedir
    // disponibilidad. No lleva datos sensibles -- de quién ocupa cada
    // panel no se dice nada acá, eso sale de contratos, que sí está
    // restringido.
    match /paneles/{id} {
      allow read: if esCuentaDePortal();
      allow write: if false; // crearPanel / actualizarPanel / eliminarPanel / recalcularEstadoPaneles
    }

    // ── Solicitudes de campaña ──────────────────────────────────────
    // La ÚNICA escritura que hace el navegador en toda la aplicación:
    // el personal marca una solicitud como revisada o rechazada.
    // Acotada a los dos campos de estado -- sin ese límite se podría
    // reescribir el contenido de la solicitud (cliente, paneles, fechas)
    // desde la consola del navegador.
    match /solicitudesCampana/{id} {
      allow read: if esAdminPortal() || esDeMiCliente();
      // CERRADO. Antes el navegador del admin podía cambiar el estado
      // directamente (acotado a esos dos campos). Funcionaba, pero era
      // el ÚNICO camino de escritura sobre esta colección que no pasaba
      // por una Cloud Function, y eso impedía guardar las solicitudes en
      // el resumen de cada cliente: al marcar una como revisada, el
      // resumen quedaba desfasado sin que nada se enterara. Ahora pasa
      // por actualizarEstadoSolicitud, que valida el estado (lo validaba
      // esta regla) y regenera el resumen en el mismo paso.
      allow update: if false; // actualizarEstadoSolicitud
      allow create, delete: if false; // crearSolicitudCampana / eliminarSolicitudCampana
    }

    match /invitacionesPortal/{id} {
      allow read: if esAdminPortal();
      allow write: if false; // crearClienteAcceso / administrarUsuarioPortal
    }

    // ── Copia del inventario en un solo documento ───────────────────
    // Cobertura muestra todo el inventario a cada cliente. Antes eso
    // costaba una lectura POR PANEL en cada sesión -- el 60% del gasto
    // de una sesión, y lo pagaba hasta quien nunca abría el mapa.
    // El backend mantiene acá una copia completa (ver
    // functions/src/agregadoPaneles.ts): leerla cuesta 1 lectura.
    //
    // Mismo permiso que la colección "paneles": no lleva nada que no
    // esté ya ahí, solo agrupado. La escritura la hacen las Cloud
    // Functions con el Admin SDK, que no pasan por estas reglas.
    // ANTES ESTO ERA `allow read: if esCuentaDePortal()` PARA TODO EL
    // GRUPO. Daba igual mientras el único documento fuese el inventario
    // de paneles, que es el mismo para todo el mundo y ya se ve en
    // Cobertura. Pero acá dentro entra ahora la LISTA DE CLIENTES, y con
    // la regla en bloque cualquier cliente podría leer los nombres de
    // todos los demás. Se cierra documento por documento.
    match /agregados/{documento} {
      allow read: if
        // Inventario de paneles: público para cualquier cuenta del portal.
        (documento == 'paneles' && esCuentaDePortal())
        // Lista de clientes para el selector, repartida en partes
        // (clientes-0, clientes-1...). SOLO personal interno.
        || (documento.matches('clientes-[0-9]+') && esPersonalDePortal())
        // Resumen de UN cliente (sus campañas): cliente-<id>. Solo lo lee
        // ese mismo cliente, o el personal interno. El id va en la RUTA,
        // así que cambiar la URL no sirve de nada: la comparación es
        // contra el clienteId que consta en portalUsers, no contra nada
        // que mande el navegador.
        || (documento.matches('cliente-.*') &&
            (esPersonalDePortal() ||
             (esCuentaDePortal() && documento == 'cliente-' + clienteIdDelPortal())));
      allow write: if false;
    }

    // ── Cierre por defecto ──────────────────────────────────────────
    // Cubre a la vez tres cosas:
    //
    //  1. Las colecciones del ERP que ya no se usan (gastos, proveedores,
    //     sueldos, configuracion, config) y el formulario de la web
    //     pública (solicitudesWeb). Los datos NO se borran -- siguen en
    //     Firestore por si alguna vez hacen falta -- pero dejan de ser
    //     accesibles desde cualquier navegador. Si algún día hay que
    //     recuperarlos, se hace con el Admin SDK, que no pasa por acá.
    //
    //  2. Las colecciones que la aplicación usa SOLO a través de Cloud
    //     Functions (cotizaciones, solicitudesAccion): nunca se piden
    //     desde el navegador, así que no necesitan permiso.
    //
    //  3. Cualquier colección futura a la que se olvide ponerle regla:
    //     queda inaccesible, que es el fallo seguro.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
