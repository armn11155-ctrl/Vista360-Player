# Cloudflare Pages lee este archivo para poner Cache-Control por ruta.
# Sin esto, TODO se sirve con el header por defecto de Pages (revalida
# en cada carga), incluidos los JS/CSS que Vite ya nombra con un hash
# de contenido (ej. index-cqgnt120.js) -- esos nunca cambian de
# contenido bajo el mismo nombre, asi que se pueden cachear para
# siempre sin riesgo: si el codigo cambia, el nombre del archivo
# tambien cambia.

# JS/CSS con hash de Vite -- cache maximo, "immutable" le dice al
# navegador que ni siquiera revalide, se salta la red por completo.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# El HTML (shell de la SPA) y el manifest SI pueden cambiar de
# contenido sin cambiar de nombre -- deben revalidarse siempre para
# que el usuario reciba las referencias a los assets nuevos despues de
# cada deploy.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# El visor PDF es un HTML independiente con nombre fijo. Revalidarlo evita
# que Safari conserve una version anterior despues de publicar un ajuste.
/visor-pdf.html
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=3600

# El service worker se debe revisar seguido para que las actualizaciones
# lleguen rapido -- si el navegador lo cachea de mas, un deploy nuevo
# puede tardar en notarse.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Iconos/imagenes estaticas sueltas (no llevan hash de contenido, a
# diferencia de /assets/*) -- antes esto cacheaba 24h fijas, y cada vez
# que se reemplazaba un PNG (icono, logo, pin del mapa) la gente seguia
# viendo el archivo viejo hasta que pasaran esas 24h o hicieran un
# refresh forzado a mano. must-revalidate le dice al navegador que
# SIEMPRE confirme con el servidor si el archivo sigue igual (Cloudflare
# responde con un ETag basado en el contenido -- si no cambio, la
# respuesta es un 304 rapido sin re-descargar nada; si cambio, se trae
# la version nueva de una, sin esperar ningun plazo).
/*.png
  Cache-Control: public, max-age=0, must-revalidate

/*.svg
  Cache-Control: public, max-age=0, must-revalidate

# Headers de seguridad basicos para TODAS las rutas -- ninguno de estos
# cambia como se ve o funciona la app, solo le dicen al navegador que
# sea mas estricto. Los comentarios van ANTES del bloque (no mezclados
# con los headers) porque la sintaxis de _headers de Cloudflare Pages
# no documenta comentarios dentro de un bloque de reglas.
#
# X-Frame-Options: evita que la app se pueda incrustar en un <iframe>
# de otro sitio (clickjacking) -- nadie tiene por que embeber el
# portal de clientes.
# X-Content-Type-Options: el navegador no debe "adivinar" el tipo de
# un archivo por su contenido en vez de confiar en el Content-Type real.
# Referrer-Policy: al navegar a un link externo, manda el origen pero
# no la URL completa (que podria incluir datos del cliente en la ruta).
# Permissions-Policy: apaga permisos de navegador que la app nunca pide
# (camara, microfono, ubicacion, pagos, sensores) -- si algun dia se
# necesitan de verdad, se habilitan puntualmente aca.
#
# No incluye Content-Security-Policy todavia: una CSP mal armada puede
# romper la carga de Firebase/R2 en silencio y no hay forma de probarla
# visualmente antes de publicar, asi que se deja para una pasada aparte
# con mas cuidado.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
